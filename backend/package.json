{
  "name": "all-x-backend-cms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "payload": "payload",
    "db:reset": "node -e \"const fs=require('fs');const f='allx-cms.db';if(fs.existsSync(f)){fs.copyFileSync(f,f+'.bak-'+Date.now());}for(const s of ['','-shm','-wal','-journal']){fs.rmSync(f+s,{force:true})}console.log('Banco local recriado no proximo npm run dev (backup salvo como '+f+'.bak-*)')\""
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.93.0",
    "@payloadcms/db-sqlite": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "graphql": "^16.9.0",
    "next": "^16.4.5",
    "payload": "3.93.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
